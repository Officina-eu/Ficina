# Caddy fronts the HTTPS origin for Ficina. It does NOT obtain certificates
# here — the dedicated `certbot` service obtains and renews one Let's Encrypt
# certificate into the shared `certs` volume, and every service (Caddy, SMTP,
# IMAP) reads it from the same stable path /certs/live/<domain>/. Caddy just
# terminates TLS on 443 and reverse-proxies to the internal JMAP + OIDC
# service. See docker-compose.yml and README.md.

{
	# We manage certificates with certbot, not Caddy's own ACME.
	auto_https off
}

# The mail + login origin: the JMAP API + OIDC provider (login, discovery,
# JWKS, token, userinfo) — and, later, webmail — all live here.
https://{$DOMAIN} {
	tls /certs/live/{$DOMAIN}/fullchain.pem /certs/live/{$DOMAIN}/privkey.pem
	encode zstd gzip
	reverse_proxy ficina-jmap:8080
}

# MTA-STS policy host (RFC 8461). Senders fetch
# https://mta-sts.<domain>/.well-known/mta-sts.txt. Covered by the same
# certificate (issued with both names as SANs — see init-certs.sh).
https://mta-sts.{$DOMAIN} {
	tls /certs/live/{$DOMAIN}/fullchain.pem /certs/live/{$DOMAIN}/privkey.pem
	reverse_proxy ficina-smtp:8461
}
