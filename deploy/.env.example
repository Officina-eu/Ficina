# Ficina deploy environment — copy to .env and fill in real values.
# Every value here is a placeholder; .env itself is gitignored and
# real secrets never enter the repo (CLAUDE.md law 1).

# --- PostgreSQL (system of record) ---
POSTGRES_USER=ficina
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ficina

# --- Garage (S3 blob store) ---
# 32-byte hex secret shared by garage nodes: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-64-hex-chars
GARAGE_ADMIN_TOKEN=change-me

# --- ficina-smtp ---
FICINA_SMTP_HOSTNAME=mx.ficina.test
RUST_LOG=info

# --- Synapse (chat engine) ---
SYNAPSE_SERVER_NAME=chat.ficina.test

# --- Collabora (docs engine) ---
COLLABORA_ADMIN_USER=ficina-admin
COLLABORA_ADMIN_PASSWORD=change-me
# Regex of WOPI hosts allowed to embed the editor (Ficina Drive).
COLLABORA_ALIASGROUP1=http://drive\.ficina\.test:80
