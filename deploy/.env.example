# Ficina deploy environment — copy to .env and fill in real values.
# Every value here is a placeholder; .env itself is gitignored and
# real secrets never enter the repo (CLAUDE.md law 1).

# --- PostgreSQL (system of record) ---
POSTGRES_USER=ficina
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ficina

# --- Garage (S3 blob store) ---
# 32-byte hex secret shared by garage nodes: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-64-hex-chars
GARAGE_ADMIN_TOKEN=change-me

# --- ficina-smtp ---
FICINA_SMTP_HOSTNAME=mx.ficina.test
RUST_LOG=info
# Outbound delivery is OFF by default (relay safety). Enabling it
# REQUIRES FICINA_SMTP_LOCAL_DOMAINS to be set (else the MX would be an
# open relay) — refused at startup otherwise.
FICINA_SMTP_OUTBOUND_ENABLED=false
# Route all outbound mail through one host (host:port). Empty = MX.
FICINA_SMTP_SMARTHOST=
# Retry schedule and queue cadence (seconds / count).
FICINA_SMTP_RETRY_BASE_SECS=60
FICINA_SMTP_RETRY_CAP_SECS=3600
FICINA_SMTP_MAX_ATTEMPTS=8
FICINA_SMTP_QUEUE_INTERVAL_SECS=30
# --- ficina-smtp: TLS + submission (M3) ---
# Submission listeners (blank disables). STARTTLS on 587, implicit TLS
# on 465.
FICINA_SMTP_SUBMISSION_ADDR=
FICINA_SMTP_IMPLICIT_TLS_ADDR=
# TLS certificate + key (PEM). Leave blank ONLY for development, and
# then set FICINA_SMTP_ALLOW_SELF_SIGNED=true — a production server
# refuses to start without a real certificate.
FICINA_SMTP_TLS_CERT=
FICINA_SMTP_TLS_KEY=
FICINA_SMTP_ALLOW_SELF_SIGNED=false
# Submission credentials (dev AUTH bootstrap; ficina-identity replaces
# it in M9). One username:password per line. Blank = AUTH always fails.
FICINA_SMTP_CREDENTIALS_FILE=
# Hosted domains this MX accepts mail for (comma-separated). The
# anti-open-relay allowlist; required before outbound may be enabled.
FICINA_SMTP_LOCAL_DOMAINS=
# --- ficina-smtp: DKIM signing (M4) ---
# Sign submitted mail. All three must be set together (or none). The
# key file must be PKCS#8 PEM and not group/world-readable. Publish the
# public key at <selector>._domainkey.<domain> in DNS.
FICINA_SMTP_DKIM_DOMAIN=
FICINA_SMTP_DKIM_SELECTOR=
FICINA_SMTP_DKIM_KEY=
# rsa (default) or ed25519.
FICINA_SMTP_DKIM_ALGORITHM=rsa

# --- ficina-smtp: Rspamd spam scoring (M4b) ---
# Consulted at DATA (POST /checkv2). Unset = no scanning. When set, a
# scanner outage FAILS CLOSED (451) — a down scanner never silently
# disables filtering. The controller runs as a pinned container; the
# scan worker listens on 11333 (no auth on /checkv2).
FICINA_SMTP_RSPAMD_URL=
# Per-call timeout in seconds (default 10).
FICINA_SMTP_RSPAMD_TIMEOUT_SECS=10

# --- ficina-smtp: MTA-STS policy (M4b, RFC 8461) ---
# Address to serve GET /.well-known/mta-sts.txt (plaintext; the deploy
# reverse proxy terminates TLS for mta-sts.<domain>). Unset = not served.
FICINA_SMTP_MTA_STS_ADDR=
# enforce (default) | testing | none.
FICINA_SMTP_MTA_STS_MODE=enforce
# Comma-separated MX patterns (default: the server hostname).
FICINA_SMTP_MTA_STS_MX=
# Policy lifetime in seconds (default 604800 = 1 week).
FICINA_SMTP_MTA_STS_MAX_AGE=604800
# Optional explicit policy id; derived from the policy content if unset.
FICINA_SMTP_MTA_STS_ID=
# DNS to publish alongside: _mta-sts.<domain> TXT "v=STSv1; id=<rendered id>"
# and mta-sts.<domain> A/AAAA (or CNAME) to the TLS proxy fronting the
# policy endpoint.

# --- Synapse (chat engine) ---
SYNAPSE_SERVER_NAME=chat.ficina.test

# --- Collabora (docs engine) ---
COLLABORA_ADMIN_USER=ficina-admin
COLLABORA_ADMIN_PASSWORD=change-me
# Regex of WOPI hosts allowed to embed the editor (Ficina Drive).
COLLABORA_ALIASGROUP1=http://drive\.ficina\.test:80
