  "query": "SELECT m.id, m.thread_id, m.subject, m.from_addr, m.sent_at, m.received_at, m.size FROM mailbox_messages mm JOIN messages m ON m.id = mm.message_id AND m.tenant_id = mm.tenant_id WHERE mm.tenant_id = $1 AND mm.mailbox_id = $2 ORDER BY mm.added_at DESC LIMIT $3 OFFSET $4",
